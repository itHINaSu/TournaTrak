# Runtime data — never commit live results or secrets.
# Allowlist pattern: everything under files/ is ignored except the tracked
# example. This covers newer runtime files (offsets.json, field-colors.json,
# theme-colors.json, sessions.json, legacy admin.json) automatically instead
# of relying on a hand-maintained per-file list.
files/*
!files/schedule.example.json

# Demo sandbox runtime data (recreated from demo-seed/ on every reset).
# demo-seed/ itself IS tracked — it's the canonical demo snapshot.
# Track the directory placeholder so git clones create demo-files/ with
# user-owned permissions; Docker bind mounts then re-use the existing dir
# instead of creating a new root:root one that the node user can't write to.
demo-files/*
!demo-files/.gitkeep

# Docker and system noise
.env
*.log
node_modules/

# Editor/OS noise
.DS_Store
.vscode/
*.swp
*.bak
frontend/icons/source_*.png
