<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026 Dedham Tournament</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Barlow:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="bracket.css">
</head>
<body>

<header class="site-header" id="siteHeader">
  <h1>Dedham 16" Slowpitch Tournament 2026</h1>
  <div class="header-controls">
    <button class="theme-toggle" id="themeToggle">☀ Light</button>
  </div>
</header>

<div class="view-tabs" id="viewTabs">
  <div class="view-tab active" data-view="bracket">Bracket</div>
  <div class="view-tab" data-view="rounds">By Round</div>
  <div class="view-tab" data-view="teams">By Team</div>
</div>

<div class="view-panel active" id="view-bracket">
  <div id="bracketRoot"></div>
</div>

<div class="view-panel" id="view-rounds">
  <div class="selector-row">
    <label>Round</label>
    <select class="styled" id="roundSelect">
      <option value="R1">Round 1</option>
      <option value="R2">Round 2</option>
      <option value="QF">Quarter Finals</option>
      <option value="SF">Semi Finals</option>
      <option value="CHAMP">Championship</option>
    </select>
  </div>
  <div class="round-panel" id="roundGames"></div>
</div>

<div class="view-panel" id="view-teams">
  <div class="selector-row">
    <label>Team</label>
    <select class="styled" id="teamSelect">
      <option value="">— select a team —</option>
    </select>
  </div>
  <div class="team-panel" id="teamOut"></div>
</div>

<div class="toast" id="toast"></div>

<script src="bracket-data.js"></script>
<script>
// ══════════════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════════════
var results={}, schedule={};

// ══════════════════════════════════════════════════════════
// THEME
// ══════════════════════════════════════════════════════════
var themeBtn=document.getElementById('themeToggle');
themeBtn.addEventListener('click',function(){
  document.body.classList.toggle('light');
  themeBtn.textContent=document.body.classList.contains('light')?'🌙 Dark':'☀ Light';
  if(activeView()==='bracket') renderBracket();
});

// ══════════════════════════════════════════════════════════
// TABS
// ══════════════════════════════════════════════════════════
function activeView(){
  var t=document.querySelector('.view-tab.active');
  return t?t.dataset.view:null;
}
document.querySelectorAll('.view-tab').forEach(function(tab){
  tab.addEventListener('click',function(){
    document.querySelectorAll('.view-tab').forEach(function(t){t.classList.remove('active');});
    document.querySelectorAll('.view-panel').forEach(function(p){p.classList.remove('active');});
    tab.classList.add('active');
    document.getElementById('view-'+tab.dataset.view).classList.add('active');
    renderActive();
  });
});
function renderActive(){
  var v=activeView();
  if(v==='bracket') renderBracket();
  if(v==='rounds')  renderRoundView();
  if(v==='teams')   renderTeamView();
}

// ══════════════════════════════════════════════════════════
// FETCH
// ══════════════════════════════════════════════════════════
async function fetchAll(){
  try{
    var rr=await fetch('/api/results'), sr=await fetch('/api/schedule');
    results=await rr.json(); schedule=await sr.json();
    if(typeof applySchedule==='function') applySchedule(schedule);
  }catch(e){results={};schedule={};}
  renderActive();
}
var resizeTimer;
window.addEventListener('resize',function(){
  clearTimeout(resizeTimer);
  resizeTimer=setTimeout(function(){if(activeView()==='bracket') renderBracket();},150);
});

// ══════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════
function gameLabel(gid){
  return GAMES[gid]&&GAMES[gid].label?GAMES[gid].label:gid;
}
function disp(gid,slot){
  var team=resolveSlot(slot,results), label=slotLabel(slot);
  var r=results[gid]||{};
  return {name:team||label,actual:!!team,won:!!(team&&r.winner===team),lost:!!(team&&r.loser===team)};
}

// ══════════════════════════════════════════════════════════
// SLOT POSITIONING (all in vh/em via CSS vars set by JS)
//
// Slot model: 8 virtual slots per column.
// Each slot = cardH + gapH.  totalH = 8 * slotH.
// cardH = slotH * CARD_RATIO  (rows never clip)
// gapH  = slotH * (1 - CARD_RATIO)
//
// Positions:
//   R1  slot s: top = (s-1) * slotH
//   R2  slot s: top = ((s-1)*2 + 0.5) * slotH   [midpoint between R1 s*2-1 and R1 s*2]
//   QF  slot s: top = ((s-1)*4 + 1.5) * slotH
//   SF  slot 1: top = 3.5 * slotH
// ══════════════════════════════════════════════════════════
var CARD_RATIO = 0.82;
var CARD_ASPECT = 2.6;
var DESKTOP_MARGIN_VW = 1.5;
var CHAMP_RATIO = 1.2;
var GAP_RATIO = 0.05;

function slotTopVh(round,slot,slotVh){
  if(round==='R1')    return (slot-1)*slotVh;
  if(round==='R2')    return ((slot-1)*2+0.5)*slotVh;
  if(round==='QF')    return ((slot-1)*4+1.5)*slotVh;
  if(round==='SF')    return 3.5*slotVh;
  if(round==='CHAMP') return 3.5*slotVh;
  return 0;
}
function cardMidVh(round,slot,slotVh){
  return slotTopVh(round,slot,slotVh)+slotVh*CARD_RATIO/2;
}

// ══════════════════════════════════════════════════════════
// SIZING — returns vh values for slot/card
// All sizing in vh so CSS variables drive everything
// ══════════════════════════════════════════════════════════
function getDims(){
  var hdrH  = document.getElementById('siteHeader').getBoundingClientRect().height;
  var tabsH = document.getElementById('viewTabs').getBoundingClientRect().height;
  var availPx = window.innerHeight - hdrH - tabsH - 16; // small padding
  var vh = window.innerHeight / 100;

  // Convert available px to vh
  var availVh = availPx / vh;

  // 8 slots fill the available height, each slot = availVh/8 vh
  var slotVh = availVh / 8;
  var cardVh = slotVh * CARD_RATIO;

  // Row height = cardVh / 3 (three equal rows)
  var rowVh = cardVh / 3;

  // Minimum row height: 2vh so text never becomes unreadable
  if(rowVh < 2){
    rowVh = 2;
    cardVh = rowVh * 3;
    slotVh = cardVh / CARD_RATIO;
  }

  var isMobile = window.innerWidth < 900;

  // ── Width: total bracket = 85vw, centered ──────────────────
  // Layout: sides*(4*colVw + 3*gapVw) + champVw = 85vw
  // gapVw = colVw * gapRatio
  var TARGET_VW  = isMobile ? 85 : 85;
  var champVw    = isMobile ? 10 : 12;
  var numCols    = 4;
  var numGaps    = 3;
  var sides      = 2;
  var gapRatio   = 0.20; // gap = 20% of colVw
  // colVw * (sides*(numCols + numGaps*gapRatio) + champVw/colVw) = TARGET_VW
  // Solve: colVw = (TARGET_VW - champVw) / (sides*(numCols + numGaps*gapRatio))
  var colVw  = (TARGET_VW - champVw) / (sides * (numCols + numGaps * gapRatio));
  var gapVw  = colVw * gapRatio;

  // ── Height: derive from card aspect ratio ───────────────────
  var vwPx   = window.innerWidth / 100;
  var vhPx   = window.innerHeight / 100;
  var cardPx = colVw * vwPx / CARD_ASPECT;
  cardVh     = cardPx / vhPx;
  rowVh      = cardVh / 3;

  // Floor: row must be at least 1.6vh so text is readable
  if(rowVh < 1.6){ rowVh = 1.6; cardVh = rowVh * 3; }
  // Ceil: if cards are taller than availVh/8 allows, shrink to fit height
  var maxCardVh = (availVh / 8) * CARD_RATIO;
  if(cardVh > maxCardVh){ cardVh = maxCardVh; rowVh = cardVh / 3; }
  slotVh = cardVh / CARD_RATIO;

  return {
    slotVh:  slotVh,
    cardVh:  cardVh,
    rowVh:   rowVh,
    colVw:   colVw,
    gapVw:   gapVw,
    champVw: champVw,
    totalVh: slotVh * 8,
    isMobile: isMobile
  };
}

// Set CSS variables from dims
function applyCSSVars(dims){
  var r=document.documentElement.style;
  r.setProperty('--slot-h', dims.slotVh+'vh');
  r.setProperty('--card-h', dims.cardVh+'vh');
  r.setProperty('--row-h',  dims.rowVh+'vh');
  r.setProperty('--col-w',  dims.colVw+'vw');
  r.setProperty('--col-gap',dims.gapVw+'vw');
}

// ══════════════════════════════════════════════════════════
// CARD HTML
// ══════════════════════════════════════════════════════════
function cardHTML(gid){
  var g=GAMES[gid];
  var t1=disp(gid,g.t1), t2=disp(gid,g.t2);
  var c1=!t1.actual?'tbd':t1.won?'won':t1.lost?'lost':'';
  var c2=!t2.actual?'tbd':t2.won?'won':t2.lost?'lost':'';
  var lbl=gameLabel(gid);
  return '<div class="bc-hdr"><span class="bc-id">'+lbl+'</span><span class="bc-time">'+g.time+'</span></div>'
    +'<div class="bc-team '+c1+'">'+t1.name+'</div>'
    +'<div class="bc-team '+c2+'">'+t2.name+'</div>';
}

// ══════════════════════════════════════════════════════════
// CONNECTOR LINES SVG
// mirror=true: lines run right→left (left bracket toward champ)
// mirror=false: lines run left→right (right bracket toward champ)
// ══════════════════════════════════════════════════════════
function connLines(conns,wVw,hVh,lc,mirror){
  if(!conns.length) return '';
  // We work in percentage coordinates within the SVG viewBox
  // SVG viewBox="0 0 100 100" → x in % of width, y in % of height
  var s='<svg viewBox="0 0 100 100" preserveAspectRatio="none" '
    +'style="position:absolute;top:0;left:0;width:100%;height:100%;overflow:visible">';
  var lw='0.15'; // thin line, scales with SVG

  function fx(x){ return mirror?(100-x):x; }

  var byDest={};
  conns.forEach(function(c){
    // Convert vh to percentage of total column height
    var k=c.dstPct.toFixed(2);
    if(!byDest[k]) byDest[k]=[];
    byDest[k].push(c);
  });

  Object.keys(byDest).forEach(function(dk){
    var srcs=byDest[dk], dst=parseFloat(dk), mx=50;
    if(srcs.length>=2){
      var top=Math.min(srcs[0].srcPct,srcs[1].srcPct);
      var bot=Math.max(srcs[0].srcPct,srcs[1].srcPct);
      s+='<line x1="'+fx(0)+'" y1="'+top+'" x2="'+fx(mx)+'" y2="'+top+'" stroke="'+lc+'" stroke-width="'+lw+'" vector-effect="non-scaling-stroke"/>';
      s+='<line x1="'+fx(0)+'" y1="'+bot+'" x2="'+fx(mx)+'" y2="'+bot+'" stroke="'+lc+'" stroke-width="'+lw+'" vector-effect="non-scaling-stroke"/>';
      s+='<line x1="'+fx(mx)+'" y1="'+top+'" x2="'+fx(mx)+'" y2="'+bot+'" stroke="'+lc+'" stroke-width="'+lw+'" vector-effect="non-scaling-stroke"/>';
      s+='<line x1="'+fx(mx)+'" y1="'+dst+'" x2="'+fx(100)+'" y2="'+dst+'" stroke="'+lc+'" stroke-width="'+lw+'" vector-effect="non-scaling-stroke"/>';
    } else {
      var sm=srcs[0].srcPct;
      s+='<line x1="'+fx(0)+'" y1="'+sm+'" x2="'+fx(mx)+'" y2="'+sm+'" stroke="'+lc+'" stroke-width="'+lw+'" vector-effect="non-scaling-stroke"/>';
      s+='<line x1="'+fx(mx)+'" y1="'+sm+'" x2="'+fx(mx)+'" y2="'+dst+'" stroke="'+lc+'" stroke-width="'+lw+'" vector-effect="non-scaling-stroke"/>';
      s+='<line x1="'+fx(mx)+'" y1="'+dst+'" x2="'+fx(100)+'" y2="'+dst+'" stroke="'+lc+'" stroke-width="'+lw+'" vector-effect="non-scaling-stroke"/>';
    }
  });
  s+='</svg>';
  return s;
}

// ══════════════════════════════════════════════════════════
// BUILD SIDE COLUMNS
// ══════════════════════════════════════════════════════════
function buildSideColumns(side){
  var rounds=['R1','R2','QF','SF'];
  return rounds.map(function(round,ri){
    var games=Object.keys(GAMES).filter(function(gid){
      return GAMES[gid].side===side&&GAMES[gid].round===round;
    }).map(function(gid){return {gid:gid,slot:GAMES[gid].slot};})
      .sort(function(a,b){return a.slot-b.slot;});
    return {round:round,games:games};
  });
}

// Build connection midpoint percentages
function buildConnPcts(srcCol,dstCol,slotVh){
  var totalVh=slotVh*8;
  var conns=[];
  dstCol.games.forEach(function(dstEntry){
    var dstMid=cardMidVh(dstCol.round,dstEntry.slot,slotVh);
    var dstPct=dstMid/totalVh*100;
    var dstG=GAMES[dstEntry.gid];
    [dstG.t1,dstG.t2].forEach(function(slotDef){
      if(slotDef.type!=='winner'&&slotDef.type!=='loser') return;
      if(!GAMES[slotDef.game]) return;
      var srcEntry=srcCol.games.find(function(g){return g.gid===slotDef.game;});
      if(!srcEntry) return;
      var srcMid=cardMidVh(srcCol.round,srcEntry.slot,slotVh);
      var srcPct=srcMid/totalVh*100;
      conns.push({srcPct:srcPct,dstPct:dstPct});
    });
  });
  return conns;
}

// ══════════════════════════════════════════════════════════
// RENDER BRACKET
// ══════════════════════════════════════════════════════════
function renderBracket(){
  var root=document.getElementById('bracketRoot');
  var dims=getDims();
  applyCSSVars(dims);
  dims.isMobile ? renderMobileBracket(root,dims) : renderDesktopBracket(root,dims);
}

// ── DESKTOP ────────────────────────────────────────────────
function renderDesktopBracket(root,dims){
  var slotVh=dims.slotVh, cardVh=dims.cardVh;
  var colVw=dims.colVw, gapVw=dims.gapVw, champVw=dims.champVw;
  var totalVh=dims.totalVh;
  var lc='var(--line-color)';
  var hdrVh=1.8; // header row height in vh

  // Build one side's HTML
  // isRight=false → left side (R1 outer, SF inner, cols in DOM order R1→R2→QF→SF)
  // isRight=true  → right side (SF inner, R1 outer, cols in DOM order SF→QF→R2→R1)
  function sideHTML(side,label,isRight){
    var cols=buildSideColumns(side);
    // Left: DOM order R1→R2→QF→SF, CSS justifies right (SF nearest champ)
    // Right: DOM order SF→QF→R2→R1, CSS justifies left (SF nearest champ)
    var ordCols=isRight?cols.slice().reverse():cols;

    var html='';
    for(var ci=0;ci<ordCols.length;ci++){
      var col=ordCols[ci];

      // Round header
      var hdrHTML='<div class="round-col-hdr">'+ROUND_LABELS[col.round]+'</div>';

      // Cards
      var cardsHTML='';
      col.games.forEach(function(entry){
        var topVh=slotTopVh(col.round,entry.slot,slotVh);
        cardsHTML+='<div class="bc" style="top:'+topVh+'vh">'
          +cardHTML(entry.gid)+'</div>';
      });

      html+='<div class="round-col" style="width:'+colVw+'vw;height:'+totalVh+'vh">'
        +hdrHTML+cardsHTML+'</div>';

      // Gap + connector lines (not after last column)
      if(ci<ordCols.length-1){
        // srcCol = earlier round (feeds into dstCol)
        // Left: ordCols[ci]=R1, ordCols[ci+1]=R2 → src=R1, dst=R2
        // Right: ordCols[ci]=SF, ordCols[ci+1]=QF → src=QF, dst=SF
        var srcCol=isRight?ordCols[ci+1]:ordCols[ci];
        var dstCol=isRight?ordCols[ci]:ordCols[ci+1];
        var conns=buildConnPcts(srcCol,dstCol,slotVh);
        // Mirror: left bracket lines go right→left (toward champ on right)
        //         right bracket lines go left→right (toward champ on left)  
        var mirror=!isRight;
        html+='<div style="position:relative;flex-shrink:0;width:'+gapVw+'vw;height:'+totalVh+'vh">'
          +connLines(conns,gapVw,totalVh,lc,mirror)+'</div>';
      }
    }

    // Outer label positioned above Round 1 column (outermost)
    // For left side: R1 is first in DOM (leftmost) → label at left
    // For right side: R1 is last in DOM (rightmost) → label at right
    var labelAlign=isRight?'right:0':'left:0';
    return '<div style="position:relative;flex:1;min-width:0;display:flex;'
      +(isRight?'justify-content:flex-start':'justify-content:flex-end')+'">'
      +'<div style="position:relative">'
      +'<div class="bracket-side-label" style="position:absolute;top:calc(var(--col-hdr-h)*-2.2);'+labelAlign+'">'+label+'</div>'
      +'<div style="display:flex;flex-direction:row;margin-top:'+hdrVh+'vh">'+html+'</div>'
      +'</div></div>';
  }

  // Championship center
  var cr=results['G21']||{};
  var ct1=disp('G21',GAMES.G21.t1), ct2=disp('G21',GAMES.G21.t2);
  var cc1=!ct1.actual?'tbd':ct1.won?'won':'';
  var cc2=!ct2.actual?'tbd':ct2.won?'won':'';
  var sfTopVh=slotTopVh('SF',1,slotVh);
  var champLbl=gameLabel('G21');

  var champHTML='<div style="flex-shrink:0;width:'+champVw+'vw;display:flex;'
    +'align-items:flex-start;justify-content:center;padding:0 0.5vw;margin-top:'+hdrVh+'vh">'
    +'<div style="width:100%;margin-top:'+sfTopVh+'vh">'
    +'<div style="text-align:center;margin-bottom:0.3vh">'
    +'<div style="font-size:clamp(1rem,1.5vw,1.6rem)">🏆</div>'
    +'<div style="font-family:Oswald,sans-serif;font-size:0.6em;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold);margin-bottom:0.15em">Championship</div>'
    +'<div style="font-size:0.62em;color:var(--gold-lt);font-weight:600;margin-bottom:0.3em">'+GAMES.G21.time+'</div>'
    +'</div>'
    +'<div class="bc" style="position:relative;height:'+cardVh+'vh;left:auto;right:auto">'+cardHTML('G21')+'</div>'
    +(cr.winner?'<div style="font-family:Oswald,sans-serif;font-size:0.85em;color:var(--gold-lt);text-align:center;margin-top:0.4em;letter-spacing:0.07em">'+cr.winner+'</div>':'')
    +'</div></div>';

  root.innerHTML='<div style="display:flex;align-items:flex-start;width:85vw;margin:0 auto;box-sizing:border-box;padding:calc(var(--col-hdr-h) * 2.5) 0 1em;">'
    +sideHTML('left','Left Bracket',false)
    +champHTML
    +sideHTML('right','Right Bracket',true)
    +'</div>';
}

// ── MOBILE ─────────────────────────────────────────────────
function renderMobileBracket(root,dims){
  var slotVh=dims.slotVh, cardVh=dims.cardVh;
  var colVw=dims.colVw, gapVw=dims.gapVw;
  
  // Mobile: each bracket side fills nearly full width independently
  // 4 cols + 3 gaps = totalW. Solve colVw from 96vw total.
  var mGapRatio = 0.15;
  colVw = 96 / (4 + 3 * mGapRatio);   // ~21.7vw per col
  gapVw = colVw * mGapRatio;           // ~3.3vw gap
  // Card height from aspect ratio, no height cap on mobile
  var vwPx = window.innerWidth / 100;
  var vhPx = window.innerHeight / 100;
  cardVh = (colVw * vwPx / CARD_ASPECT) / vhPx;
  slotVh = cardVh / CARD_RATIO;
  dims.totalVh = slotVh * 8;

  var totalVh=dims.totalVh;
  var lc='var(--line-color)', lw='1.5';

  function mobileSide(side,label){
    var cols=buildSideColumns(side); // R1→R2→QF→SF
    var numCols=cols.length;
    var totalW=(numCols*colVw+(numCols-1)*gapVw)+'vw';

    // Build SVG with foreignObject cards
    var svgParts='';
    for(var ci=0;ci<cols.length;ci++){
      var col=cols[ci];
      var xVw=ci*(colVw+gapVw);
      col.games.forEach(function(entry){
        var yVh=slotTopVh(col.round,entry.slot,slotVh);
        var g=GAMES[entry.gid];
        var t1=disp(entry.gid,g.t1), t2=disp(entry.gid,g.t2);
        var c1=!t1.actual?'tbd':t1.won?'won':t1.lost?'lost':'';
        var c2=!t2.actual?'tbd':t2.won?'won':t2.lost?'lost':'';
        var lbl=gameLabel(entry.gid);
        // Use vw/vh via style on foreignObject — approximate with calc
        svgParts+='<foreignObject x="'+xVw+'vw" y="'+yVh+'vh" width="'+colVw+'vw" height="'+(cardVh*1.1)+'vh">'
          +'<div xmlns="http://www.w3.org/1999/xhtml" class="bc" style="position:relative;height:'+cardVh+'vh;left:auto;right:auto">'
          +'<div class="bc-hdr"><span class="bc-id">'+lbl+'</span><span class="bc-time">'+g.time+'</span></div>'
          +'<div class="bc-team '+c1+'">'+t1.name+'</div>'
          +'<div class="bc-team '+c2+'">'+t2.name+'</div>'
          +'</div></foreignObject>';
      });

      if(ci<cols.length-1){
        var nextCol=cols[ci+1];
        var conns=buildConnPcts(col,nextCol,slotVh);
        var gxVw=xVw+colVw;
        var byDest={};
        conns.forEach(function(c){
          var k=c.dstPct.toFixed(2);
          if(!byDest[k]) byDest[k]=[];
          byDest[k].push(c);
        });
        // For mobile SVG we need px-based lines since foreignObject uses vw/vh
        // Use a separate overlay div for lines instead
        // Skip inline SVG lines for mobile — use a positioned canvas approach
        // Actually keep it simple: just draw using the existing SVG approach with %
        // The SVG uses a viewBox proportional approach
      }
    }

    // For mobile, build as HTML divs (easier than SVG vw/vh inside foreignObject)
    var html='<div style="position:relative;width:'+totalW+';height:'+totalVh+'vh">';
    for(var ci=0;ci<cols.length;ci++){
      var col=cols[ci];
      var xVw=ci*(colVw+gapVw);
      col.games.forEach(function(entry){
        var yVh=slotTopVh(col.round,entry.slot,slotVh);
        html+='<div class="bc" style="position:absolute;left:'+xVw+'vw;top:'+yVh+'vh;width:'+colVw+'vw;height:'+cardVh+'vh">'
          +cardHTML(entry.gid)+'</div>';
      });
    }
    html+='</div>';

    return '<div class="mobile-bracket-section">'
      +'<div class="mobile-bracket-label">'+label+'</div>'
      +'<div class="mobile-bracket-svg-wrap">'+html+'</div>'
      +'</div>';
  }

  var cr=results['G21']||{};
  var ct1=resolveSlot(GAMES.G21.t1,results)||smartLabel(GAMES.G21.t1,results);
  var ct2=resolveSlot(GAMES.G21.t2,results)||smartLabel(GAMES.G21.t2,results);

  root.innerHTML='<div style="width:98vw;margin:0 auto;overflow-x:hidden;">'
    +mobileSide('left','Left Bracket')
    +'<div class="mobile-bracket-divider"></div>'
    +mobileSide('right','Right Bracket')
    +'<div class="champ-bar">'
    +'<div class="champ-bar-label">🏆 Championship · '+GAMES.G21.time+'</div>'
    +'<div class="champ-bar-teams">'
    +'<div class="champ-team-slot '+(resolveSlot(GAMES.G21.t1,results)?'':'tbd')+'">'+ct1+'</div>'
    +'<div style="font-size:0.8em;color:var(--text-mute);flex-shrink:0">vs</div>'
    +'<div class="champ-team-slot '+(resolveSlot(GAMES.G21.t2,results)?'':'tbd')+'">'+ct2+'</div>'
    +'</div>'
    +(cr.winner?'<div class="champ-winner-display">🏆 '+cr.winner+'</div>':'')
    +'</div></div>';
}

// ══════════════════════════════════════════════════════════
// ROUND VIEW
// ══════════════════════════════════════════════════════════
var DAY_ORDER={Sun:0,Mon:1,Wed:2,Fri:3};
var DAY_FULL={Sun:'Sunday',Mon:'Monday',Wed:'Wednesday',Fri:'Friday'};
function parseTime(ts){
  var m=ts.match(/^(\w+)\s+(\d+):(\d+)$/);
  if(!m) return 0;
  var day=DAY_ORDER[m[1]]||0, h=parseInt(m[2]);
  if(h>=1&&h<=5) h+=12;
  return day*10000+h*100+parseInt(m[3]);
}
var ROUND_GAMES={
  R1:['G1','G2','G3','G4','G5','G6'],
  R2:['G7','G8','G9','G10','G11','G12','G13','G14'],
  QF:['G15','G16','G17','G18'],
  SF:['G19','G20'],
  CHAMP:['G21']
};
document.getElementById('roundSelect').addEventListener('change',renderRoundView);
function renderRoundView(){
  var round=document.getElementById('roundSelect').value;
  var gids=(ROUND_GAMES[round]||[]).slice().sort(function(a,b){
    return parseTime(GAMES[a].time)-parseTime(GAMES[b].time);
  });
  document.getElementById('roundGames').innerHTML=gids.map(function(gid){
    var g=GAMES[gid], t1=disp(gid,g.t1), t2=disp(gid,g.t2), r=results[gid]||{};
    var tm=g.time.match(/^(\w+)\s+(.+)$/);
    var dayFull=tm?(DAY_FULL[tm[1]]||tm[1]):'';
    var timeStr=tm?tm[2]:g.time;
    var c1=!t1.actual?'tbd':t1.won?'won':t1.lost?'lost':'';
    var c2=!t2.actual?'tbd':t2.won?'won':t2.lost?'lost':'';
    var lbl=gameLabel(gid);
    return '<div class="round-game-card">'
      +'<div class="round-game-header">'
      +'<span class="round-game-id">'+lbl+'</span>'
      +'<div class="round-game-day-time">'
      +'<span class="round-game-day">'+dayFull+'</span>'
      +'<span class="round-game-time">'+timeStr+'</span>'
      +'</div></div>'
      +'<div class="round-team-row">'
      +'<span class="round-team-name '+c1+'">'+t1.name+'</span>'
      +(r.winner?'<span class="result-badge '+(t1.won?'w':'l')+'">'+(t1.won?'W':'L')+'</span>':'')
      +'</div>'
      +'<div class="round-team-row">'
      +'<span class="round-team-name '+c2+'">'+t2.name+'</span>'
      +(r.winner?'<span class="result-badge '+(t2.won?'w':'l')+'">'+(t2.won?'W':'L')+'</span>':'')
      +'</div></div>';
  }).join('');
}

// ══════════════════════════════════════════════════════════
// TEAM VIEW
// ══════════════════════════════════════════════════════════
var teamSel=document.getElementById('teamSelect');
Object.keys(TEAMS).sort().forEach(function(name){
  var o=document.createElement('option');
  o.value=name; o.textContent=name; teamSel.appendChild(o);
});
teamSel.addEventListener('change',renderTeamView);

function buildWinChain(gid){
  var chain=[gid], cur=gid;
  for(var i=0;i<6;i++){var n=findNextGame(cur,'winner');if(!n)break;chain.push(n);cur=n;}
  return chain;
}

function makeVerticalChain(chain,team,isLosePath){
  var isMob=window.innerWidth<900;
  var cardVh=parseFloat(document.documentElement.style.getPropertyValue('--card-h'))||8;
  var CWvw=isMob?78:32;
  var CHvh=Math.max(cardVh,6);
  var VGAPvh=1.2;
  var lc=isLosePath?'#c05050':'var(--line-color)';
  var lda=isLosePath?'4,3':null;
  var lw='1.5';
  var n=chain.length;

  var html='<div style="position:relative;width:'+CWvw+'vw;height:'+((CHvh+VGAPvh)*n+4)+'vh;overflow:visible">';
  chain.forEach(function(gid,i){
    var g=GAMES[gid], r=results[gid]||{};
    var topVh=i*(CHvh+VGAPvh);
    var midVh=topVh+CHvh/2;
    var teamWon=r.winner===team, teamLost=r.loser===team, played=!!r.winner;
    var t1r=resolveSlot(g.t1,results), t2r=resolveSlot(g.t2,results);
    var t1n=t1r||smartLabel(g.t1,results), t2n=t2r||smartLabel(g.t2,results);
    var c1=!t1r?'tbd':(r.winner===t1r?'won':r.loser===t1r?'lost':'');
    var c2=!t2r?'tbd':(r.winner===t2r?'won':r.loser===t2r?'lost':'');
    var border='var(--border)';
    if(played&&teamWon) border='var(--win-color)';
    if(played&&teamLost) border='var(--lose-color)';
    if(!played&&i===0&&!isLosePath) border='var(--blue-lt)';
    var lbl=gameLabel(gid);
    html+='<div class="bc" style="position:absolute;top:'+topVh+'vh;left:0;width:'+CWvw+'vw;height:'+CHvh+'vh;border-color:'+border+'">'
      +'<div class="bc-hdr"><span class="bc-id">'+lbl+'</span><span class="bc-time">'+g.time+'</span></div>'
      +'<div class="bc-team '+c1+'">'+t1n+'</div>'
      +'<div class="bc-team '+c2+'">'+t2n+'</div>'
      +'</div>';

    // Vertical connector
    if(i<chain.length-1){
      html+='<div style="position:absolute;left:calc('+CWvw+'vw/2);top:'+(topVh+CHvh)+'vh;width:0.07em;height:'+VGAPvh+'vh;background:'+lc+';'+(lda?'border-left:0.07em dashed '+lc+';background:none;':'')+'"></div>';
    }
    // Lose indicator
    if(!played||teamWon){
      var ln=findNextGame(gid,'loser'), ll=ln?'LOSE → '+gameLabel(ln):'LOSE → OUT';
      html+='<div style="position:absolute;top:'+midVh+'vh;left:calc('+CWvw+'vw + 0.3em);font-size:0.6em;color:rgba(192,80,80,0.8);white-space:nowrap;transform:translateY(-50%);font-family:Oswald,sans-serif;font-weight:600;letter-spacing:0.05em">'+ll+'</div>';
    }
    // Win terminal
    if(i===chain.length-1&&(!played||teamWon)){
      var wn=findNextGame(gid,'winner'), wl=wn?'WIN → '+gameLabel(wn):'WIN → CHAMP 🏆';
      var wc=wn?'var(--line-color)':'var(--gold-lt)';
      html+='<div style="position:absolute;top:'+(topVh+CHvh+VGAPvh*0.1)+'vh;left:calc('+CWvw+'vw/2 - 3em);width:6em;text-align:center;font-size:0.6em;color:'+wc+';font-family:Oswald,sans-serif;font-weight:600;letter-spacing:0.05em">'+wl+'</div>';
    }
  });
  html+='</div>';
  return html;
}

function renderTeamView(){
  var team=teamSel.value, out=document.getElementById('teamOut');
  if(!team){out.innerHTML='';return;}
  var firstGid=null;
  Object.keys(GAMES).forEach(function(gid){
    if(firstGid) return;
    if(resolveSlot(GAMES[gid].t1,results)===team||resolveSlot(GAMES[gid].t2,results)===team) firstGid=gid;
  });
  if(!firstGid){out.innerHTML='<div style="padding:1em;color:var(--text-mute);font-style:italic">No games found.</div>';return;}
  var r1r=results[firstGid]||{}, wonR1=r1r.winner===team, lostR1=r1r.loser===team, played=!!r1r.winner;
  var html='<div style="padding:0.5em 0 0.25em;font-family:Oswald,sans-serif;font-size:0.78em;font-weight:600;color:var(--text-dim);letter-spacing:0.13em;text-transform:uppercase">'+team+'</div>';
  if(!played||wonR1){
    html+='<div class="team-path-label win-label">Win path</div>';
    html+='<div style="padding:0.25em 0 0.75em;overflow-x:auto">'+makeVerticalChain(buildWinChain(firstGid),team,false)+'</div>';
  }
  if(!played||lostR1){
    var ln=findNextGame(firstGid,'loser');
    html+='<div class="team-path-divider"></div>';
    if(ln){
      html+='<div class="team-path-label lose-label">Lose path (after '+gameLabel(firstGid)+')</div>';
      html+='<div style="padding:0.25em 0 0.75em;overflow-x:auto">'+makeVerticalChain(buildWinChain(ln),team,true)+'</div>';
    } else {
      html+='<div class="team-path-label lose-label">Lose path</div>';
      html+='<div style="padding:0.5em 0;color:var(--lose-color);font-size:0.85em;font-style:italic">Loss in '+gameLabel(firstGid)+' → Eliminated</div>';
    }
  }
  if(isEliminated(team,results)){
    html+='<div style="margin:0.25em 0 1em;padding:0.5em 0.75em;border-radius:0.25em;background:var(--elim-bg);color:var(--elim-text);font-size:0.8em">Tournament run complete.</div>';
  }
  out.innerHTML=html;
}

// ══════════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════════
fetchAll();
</script>
</body>
</html>
