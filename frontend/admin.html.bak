<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin — Dedham Tournament 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Barlow:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="bracket.css">
</head>
<body>

<header class="site-header">
  <h1>Tournament Admin</h1>
  <div class="header-controls">
    <a href="/" style="font-size:0.8rem;color:var(--text-dim);text-decoration:none;letter-spacing:1px;min-height:44px;display:flex;align-items:center;padding:0 8px">← Public</a>
    <button class="theme-toggle" id="themeToggle">☀ Light</button>
  </div>
</header>

<div class="admin-wrap">

  <div class="admin-section-hdr">Game Results</div>
  <div class="admin-subtitle">Select a winner for each completed game.</div>
  <div id="adminGames"></div>

  <div class="admin-section-hdr">Schedule &amp; Teams</div>
  <div class="admin-subtitle">Edit game times and team names. Only hardcoded team slots can be changed (Round 1 teams, bye assignments). Result-driven slots are set automatically.</div>
  <div style="margin-bottom:14px;display:flex;align-items:center;gap:10px">
    <button class="sched-save-btn" onclick="saveAllSchedule()" id="schedSaveBtn">Save All Changes</button>
    <span class="sched-status" id="schedStatus"></span>
  </div>
  <div id="scheduleEditor"></div>

</div>

<div class="toast" id="toast"></div>

<script src="bracket-data.js"></script>
<script>
let results  = {};
let schedule = {};

const themeBtn = document.getElementById('themeToggle');
themeBtn.addEventListener('click', () => {
  document.body.classList.toggle('light');
  themeBtn.textContent = document.body.classList.contains('light') ? '🌙 Dark' : '☀ Light';
});

function showToast(msg, error=false) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast' + (error ? ' error' : '');
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

async function fetchAll() {
  try {
    const [rr, sr] = await Promise.all([fetch('/api/results'), fetch('/api/schedule')]);
    results  = await rr.json();
    schedule = await sr.json();
    if (typeof applySchedule === 'function') applySchedule(schedule);
  } catch { results = {}; schedule = {}; }
  renderAdmin();
  renderScheduleEditor();
}

function getTeams(gid) {
  const g  = GAMES[gid];
  const t1 = resolveSlot(g.t1, results);
  const t2 = resolveSlot(g.t2, results);
  return { t1, t2, l1: slotLabel(g.t1), l2: slotLabel(g.t2) };
}

function renderAdmin() {
  const wrap = document.getElementById('adminGames');
  let html = '';
  for (const round of ROUND_ORDER) {
    const gids = Object.keys(GAMES).filter(gid => GAMES[gid].round === round);
    if (!gids.length) continue;
    html += `<div class="admin-round-hdr">${ROUND_LABELS[round]}</div>`;
    for (const gid of gids) {
      const g = GAMES[gid];
      const { t1, t2, l1, l2 } = getTeams(gid);
      const r = results[gid] || {};
      const set = !!r.winner;
      const both = t1 && t2;

      if (set) {
        html += `<div class="admin-game-row">
          <span class="admin-game-id">${gid}</span>
          <span class="admin-game-time-display">${g.time}</span>
          <span class="admin-game-teams">${t1} vs ${t2}</span>
          <span class="admin-set-label">✓ ${r.winner}</span>
          <button class="admin-clear-btn" onclick="clearResult('${gid}')">Clear</button>
        </div>`;
      } else if (both) {
        html += `<div class="admin-game-row">
          <span class="admin-game-id">${gid}</span>
          <span class="admin-game-time-display">${g.time}</span>
          <span class="admin-game-teams" style="color:var(--text)">${t1} vs ${t2}</span>
          <select class="admin-winner-sel" id="sel-${gid}">
            <option value="">— winner —</option>
            <option value="${t1}">${t1}</option>
            <option value="${t2}">${t2}</option>
          </select>
          <button class="admin-save-btn" onclick="saveResult('${gid}','${t1}','${t2}')">Save</button>
        </div>`;
      } else {
        const missing = [!t1 && l1, !t2 && l2].filter(Boolean);
        html += `<div class="admin-game-row" style="opacity:0.4">
          <span class="admin-game-id">${gid}</span>
          <span class="admin-game-time-display">${g.time}</span>
          <span class="admin-game-teams admin-locked">Waiting: ${missing.join(', ')}</span>
        </div>`;
      }
    }
  }
  wrap.innerHTML = html;
}

async function saveResult(gid, t1, t2) {
  const winner = document.getElementById(`sel-${gid}`)?.value;
  if (!winner) { showToast('Select a winner first', true); return; }
  const loser = winner === t1 ? t2 : t1;
  try {
    const r = await fetch('/api/results', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ game: gid, winner, loser }),
    });
    if (!r.ok) throw new Error();
    results[gid] = { winner, loser };
    showToast(`${gid} saved — ${winner} wins`);
    renderAdmin();
  } catch { showToast('Save failed', true); }
}

async function clearResult(gid) {
  try {
    const r = await fetch(`/api/results/${gid}`, { method: 'DELETE' });
    if (!r.ok) throw new Error();
    results[gid] = { winner: null, loser: null };
    showToast(`${gid} cleared`);
    renderAdmin();
  } catch { showToast('Clear failed', true); }
}

function renderScheduleEditor() {
  const wrap = document.getElementById('scheduleEditor');
  let html = '';
  for (const round of ROUND_ORDER) {
    const gids = Object.keys(GAMES).filter(gid => GAMES[gid].round === round);
    if (!gids.length) continue;
    html += `<div class="admin-round-hdr">${ROUND_LABELS[round]}</div>`;
    for (const gid of gids) {
      const g    = GAMES[gid];
      const over = schedule[gid] || {};
      const t1f  = g.t1.type === 'fixed';
      const t2f  = g.t2.type === 'fixed';
      const timeVal  = over.time   || g.time;
      const labelVal = over.label  || g.label;
      const t1val   = over.t1name || (t1f ? g.t1.team : '');
      const t2val   = over.t2name || (t2f ? g.t2.team : '');
      const t1disp  = t1f ? t1val : slotLabel(g.t1);
      const t2disp  = t2f ? t2val : slotLabel(g.t2);

      html += `<div class="sched-game-card">
        <div class="sched-game-hdr" onclick="toggleSched('${gid}')">
          <span class="sched-game-hdr-id">${gid}</span>
          <span class="sched-game-hdr-id" style="color:var(--text-dim)">${labelVal}</span>
          <span class="sched-game-hdr-time">${timeVal}</span>
          <span class="sched-game-hdr-teams">${t1disp} vs ${t2disp}</span>
          <span class="sched-game-hdr-arrow" id="sarrow-${gid}">▼</span>
        </div>
        <div class="sched-game-body" id="sbody-${gid}">
          <div class="sched-field">
            <label>Game Label (display name)</label>
            <input type="text" id="slabel-${gid}" value="${over.label||g.label}" placeholder="${g.label}">
          </div>
          <div class="sched-field">
            <label>Game Time</label>
            <input type="text" id="stime-${gid}" value="${timeVal}" placeholder="e.g. Sun 11:30">
          </div>
          <div class="sched-field">
            <label>Bracket Slot (virtual position 1-8)</label>
            <input type="text" id="sslot-${gid}" value="${over.slot||g.slot}" placeholder="${g.slot}">
          </div>
          ${t1f
            ? `<div class="sched-field"><label>Team 1</label><input type="text" id="st1-${gid}" value="${t1val}" placeholder="${g.t1.team}"></div>`
            : `<div style="font-size:0.75rem;color:var(--text-mute);margin-bottom:10px;font-style:italic">Team 1: ${slotLabel(g.t1)} — set by results</div>`}
          ${t2f
            ? `<div class="sched-field"><label>Team 2</label><input type="text" id="st2-${gid}" value="${t2val}" placeholder="${g.t2.team}"></div>`
            : `<div style="font-size:0.75rem;color:var(--text-mute);margin-bottom:10px;font-style:italic">Team 2: ${slotLabel(g.t2)} — set by results</div>`}
        </div>
      </div>`;
    }
  }
  wrap.innerHTML = html;
}

function toggleSched(gid) {
  const body  = document.getElementById(`sbody-${gid}`);
  const arrow = document.getElementById(`sarrow-${gid}`);
  body.classList.toggle('open');
  arrow.textContent = body.classList.contains('open') ? '▲' : '▼';
}

async function saveAllSchedule() {
  const btn    = document.getElementById('schedSaveBtn');
  const status = document.getElementById('schedStatus');
  btn.disabled = true;
  const out = {};
  for (const gid of Object.keys(GAMES)) {
    const g     = GAMES[gid];
    const tEl   = document.getElementById(`stime-${gid}`);
    const t1El  = document.getElementById(`st1-${gid}`);
    const t2El  = document.getElementById(`st2-${gid}`);
    if (!tEl) continue;
    const slotEl  = document.getElementById(`sslot-${gid}`);
    const labelEl = document.getElementById(`slabel-${gid}`);
    const entry = {};
    const tv = tEl.value.trim(); if (tv) entry.time = tv;
    if (t1El)    { const v = t1El.value.trim();    if (v) entry.t1name = v; }
    if (t2El)    { const v = t2El.value.trim();    if (v) entry.t2name = v; }
    if (slotEl)  { const v = slotEl.value.trim();  if (v) entry.slot = parseInt(v); }
    if (labelEl) { const v = labelEl.value.trim(); if (v) entry.label = v; }
    if (Object.keys(entry).length) out[gid] = entry;
  }
  try {
    const r = await fetch('/api/schedule', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify(out),
    });
    if (!r.ok) throw new Error();
    schedule = out;
    if (typeof applySchedule === 'function') applySchedule(schedule);
    showToast('Schedule saved');
    status.textContent = '✓ Saved';
    setTimeout(() => { status.textContent = ''; }, 3000);
    renderAdmin();
    renderScheduleEditor();
    // Note: bracket slot changes take effect on the public page after reload.
  } catch { showToast('Save failed', true); status.textContent = '✗ Error'; }
  btn.disabled = false;
}

fetchAll();
</script>
</body>
</html>
