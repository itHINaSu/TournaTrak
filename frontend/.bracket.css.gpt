/* bracket.css — fluid unified typography system */
/* =========================================================
   RESET
========================================================= */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* =========================================================
   ROOT TOKENS
========================================================= */

:root {

  /* ── Colors ───────────────────────────────────────── */

  --bg:           #0f1410;
  --surface:      #181f1a;
  --surface2:     #1f2921;
  --border:       #2e3d30;

  --blue:         #1a5fa8;
  --blue-lt:      #4a90d9;

  --gold:         #c49a1a;
  --gold-lt:      #e8b82a;

  --text:         #e8ede9;
  --text-dim:     #7a8f7d;
  --text-mute:    #4a5e4d;

  --win-color:    #4a9a4a;
  --lose-color:   #c05050;

  --elim-bg:      #2a1f1f;
  --elim-text:    #8a5a5a;

  --line-color:   #4a7a8a;

  --clear-color:  #c05050;
  --clear-border: #8a3a3a;

  /* ── Fluid Typography Scale ───────────────────────── */

  --fs-2xs: clamp(0.62rem, 0.58rem + 0.18vw, 0.74rem);
  --fs-xs:  clamp(0.72rem, 0.68rem + 0.22vw, 0.82rem);
  --fs-sm:  clamp(0.84rem, 0.8rem + 0.32vw, 0.96rem);
  --fs-md:  clamp(0.95rem, 0.9rem + 0.45vw, 1.1rem);
  --fs-lg:  clamp(1.15rem, 1rem + 0.8vw, 1.45rem);
  --fs-xl:  clamp(1.35rem, 1.15rem + 1.1vw, 1.8rem);

  /* ── Spacing Scale ────────────────────────────────── */

  --space-1: clamp(0.25rem, 0.22rem + 0.15vw, 0.4rem);
  --space-2: clamp(0.45rem, 0.4rem + 0.2vw, 0.65rem);
  --space-3: clamp(0.65rem, 0.6rem + 0.3vw, 0.9rem);
  --space-4: clamp(0.85rem, 0.8rem + 0.4vw, 1.2rem);
  --space-5: clamp(1rem, 0.95rem + 0.6vw, 1.5rem);

  /* ── Radius ───────────────────────────────────────── */

  --radius-sm: 0.25rem;
  --radius-md: 0.45rem;
  --radius-lg: 0.7rem;

  /* ── Bracket Geometry ─────────────────────────────── */

  --slot-h:    10vh;
  --card-h:    8vh;
  --row-h:     calc(var(--card-h) / 3);

  --col-w:     14vw;
  --col-gap:   2vw;

  --col-hdr-h: 1.6em;

  /* ── Borders ──────────────────────────────────────── */

  --border-thin: 0.07em solid var(--border);
  --border-bold: 0.14em solid var(--gold);

  /* ── Shadow ───────────────────────────────────────── */

  --shadow-sm:
    0 0.1em 0.3em rgba(0,0,0,0.18);

}

/* =========================================================
   LIGHT MODE
========================================================= */

body.light {

  --bg:        #f0f4f1;
  --surface:   #ffffff;
  --surface2:  #e8ede9;
  --border:    #c8d8ca;

  --text:      #1a2a1c;
  --text-dim:  #4a6a50;
  --text-mute: #8aaa90;

  --blue-lt:   #1a4a8a;

  --gold:      #a07800;
  --gold-lt:   #7a5800;

  --win-color: #2a6a18;
  --lose-color:#8a2a2a;

  --elim-bg:   #f5e8e8;
  --elim-text: #8a4a4a;

  --line-color:#5a8a9a;

  --clear-color:#8a2a2a;
  --clear-border:#c05050;
}

/* =========================================================
   BASE
========================================================= */

html {
  font-size: clamp(14px, 0.35vw + 13px, 18px);
}

body {

  background: var(--bg);
  color: var(--text);

  font-family: 'Barlow', sans-serif;

  min-height: 100vh;

  transition:
    background 0.2s,
    color 0.2s;

  line-height: 1.35;
}

/* =========================================================
   TYPOGRAPHY UTILITIES
========================================================= */

.text-2xs { font-size: var(--fs-2xs); }
.text-xs  { font-size: var(--fs-xs);  }
.text-sm  { font-size: var(--fs-sm);  }
.text-md  { font-size: var(--fs-md);  }
.text-lg  { font-size: var(--fs-lg);  }
.text-xl  { font-size: var(--fs-xl);  }

.oswald {
  font-family: 'Oswald', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* =========================================================
   HEADER
========================================================= */

.site-header {

  background: var(--surface);

  border-bottom: var(--border-bold);

  padding: var(--space-3) var(--space-4);

  display: flex;
  align-items: center;
  gap: var(--space-3);

  position: sticky;
  top: 0;

  z-index: 100;
}

.site-header h1 {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-lg);

  font-weight: 700;

  color: var(--gold-lt);

  letter-spacing: 0.18em;

  line-height: 1;
}

.header-controls {

  margin-left: auto;

  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.theme-toggle {

  background: none;

  border: var(--border-thin);

  border-radius: 999rem;

  padding: 0.5em 1em;

  cursor: pointer;

  font-size: var(--fs-sm);

  color: var(--text-dim);

  min-height: 2.5em;
}

.theme-toggle:hover {
  color: var(--text);
}

/* =========================================================
   TABS
========================================================= */

.view-tabs {

  display: flex;

  background: var(--surface);

  border-bottom: var(--border-thin);
}

.view-tab {

  flex: 1;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 3em;

  text-align: center;

  padding: var(--space-3);

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-sm);

  font-weight: 500;

  letter-spacing: 0.1em;

  text-transform: uppercase;

  color: var(--text-dim);

  cursor: pointer;

  border-bottom: 0.18em solid transparent;

  transition: all 0.15s;

  user-select: none;

  -webkit-tap-highlight-color: transparent;
}

.view-tab.active {

  color: var(--blue-lt);

  border-bottom-color: var(--blue-lt);
}

.view-tab:active {
  background: rgba(255,255,255,0.04);
}

/* =========================================================
   PANELS
========================================================= */

.view-panel {
  display: none;
}

.view-panel.active {
  display: block;
}

/* =========================================================
   SELECTORS
========================================================= */

.selector-row {

  display: flex;

  gap: var(--space-3);

  align-items: center;

  flex-wrap: wrap;

  padding: var(--space-3) var(--space-4);
}

.selector-row label {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-xs);

  letter-spacing: 0.1em;

  text-transform: uppercase;

  color: var(--text-dim);

  flex-shrink: 0;
}

select.styled {

  flex: 1;

  min-height: 3em;

  font-family: 'Barlow', sans-serif;

  font-size: var(--fs-md);

  font-weight: 600;

  padding: 0.7em 1em;

  border-radius: var(--radius-md);

  border: var(--border-thin);

  background: var(--surface2);

  color: var(--text);

  cursor: pointer;
}

select.styled:focus {

  outline: 0.13em solid var(--blue-lt);

  outline-offset: 0.08em;
}

/* =========================================================
   ROUND VIEW
========================================================= */

.round-panel {
  padding: 0 var(--space-4) var(--space-5);
}

.round-game-card {

  border: var(--border-thin);

  border-radius: var(--radius-lg);

  overflow: hidden;

  background: var(--surface);

  margin-bottom: var(--space-5);

  box-shadow: var(--shadow-sm);
}

.round-game-header {

  display: flex;
  align-items: center;
  gap: var(--space-3);

  padding: var(--space-3) var(--space-4);

  background: var(--surface2);

  border-bottom: var(--border-thin);
}

.round-game-id {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-xs);

  font-weight: 600;

  letter-spacing: 0.07em;

  color: var(--blue-lt);

  flex-shrink: 0;
}

.round-game-day-time {

  display: flex;
  align-items: baseline;
  gap: var(--space-2);

  flex: 1;
}

.round-game-day,
.round-game-time {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-xl);

  font-weight: 700;

  line-height: 1;
}

.round-game-day {
  color: var(--text);
}

.round-game-time {
  color: var(--gold-lt);
}

.round-team-row {

  display: flex;
  align-items: center;

  gap: var(--space-3);

  min-height: 3em;

  padding: var(--space-3) var(--space-4);

  border-bottom: var(--border-thin);
}

.round-team-row:last-child {
  border-bottom: none;
}

.round-team-name {

  flex: 1;

  font-size: var(--fs-md);

  font-weight: 600;
}

.round-team-name.tbd {

  color: var(--text-mute);

  font-style: italic;

  font-weight: 400;
}

.round-team-name.won {
  color: var(--win-color);
}

.round-team-name.lost {
  color: var(--lose-color);
}

.result-badge {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-2xs);

  font-weight: 700;

  letter-spacing: 0.07em;

  padding: 0.3em 0.7em;

  border-radius: var(--radius-sm);

  flex-shrink: 0;
}

.result-badge.w {

  background: rgba(74,154,74,0.2);

  color: var(--win-color);

  border: 0.07em solid rgba(74,154,74,0.3);
}

.result-badge.l {

  background: rgba(192,80,80,0.15);

  color: var(--lose-color);

  border: 0.07em solid rgba(192,80,80,0.25);
}

/* =========================================================
   TEAM VIEW
========================================================= */

.team-panel {
  padding: 0 var(--space-4) var(--space-5);
}

.team-path-label {

  padding: var(--space-2) 0;

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-sm);

  font-weight: 600;

  letter-spacing: 0.13em;

  text-transform: uppercase;

  color: var(--text-dim);
}

.team-path-label.win-label {
  color: var(--win-color);
}

.team-path-label.lose-label {
  color: var(--lose-color);
}

.team-path-divider {

  margin: var(--space-3) 0;

  height: 0.07em;

  background: var(--border);
}

/* =========================================================
   ADMIN
========================================================= */

.admin-wrap {

  max-width: 48rem;

  margin: 0 auto;

  padding: var(--space-5) var(--space-4);
}

.admin-title {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-lg);

  font-weight: 700;

  letter-spacing: 0.2em;

  text-transform: uppercase;

  color: var(--gold-lt);

  margin-bottom: var(--space-1);
}

.admin-subtitle {

  font-size: var(--fs-sm);

  color: var(--text-mute);

  margin-bottom: var(--space-5);
}

.admin-section-hdr {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-md);

  font-weight: 600;

  letter-spacing: 0.13em;

  text-transform: uppercase;

  color: var(--gold);

  padding: var(--space-3) 0;

  border-bottom: 0.14em solid var(--gold);

  margin: var(--space-5) 0 var(--space-4);
}

.admin-round-hdr {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-sm);

  font-weight: 600;

  letter-spacing: 0.13em;

  text-transform: uppercase;

  color: var(--text-dim);

  padding: var(--space-2) 0;

  border-bottom: var(--border-thin);

  margin: var(--space-4) 0 var(--space-3);
}

.admin-game-row {

  display: flex;

  align-items: center;

  gap: var(--space-3);

  flex-wrap: wrap;

  padding: var(--space-3) 0;

  border-bottom: var(--border-thin);
}

.admin-game-id {

  width: 2.5em;

  flex-shrink: 0;

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-xs);

  font-weight: 600;

  letter-spacing: 0.07em;

  color: var(--blue-lt);
}

.admin-game-time-display {

  width: 5.8em;

  flex-shrink: 0;

  font-size: var(--fs-xs);

  color: var(--text-mute);
}

.admin-game-teams {

  flex: 1;

  min-width: 8rem;

  font-size: var(--fs-sm);

  color: var(--text-dim);
}

.admin-winner-sel {

  min-width: 10rem;

  font-family: 'Barlow', sans-serif;

  font-size: var(--fs-sm);

  padding: 0.45em 0.65em;

  border-radius: var(--radius-sm);

  border: var(--border-thin);

  background: var(--surface2);

  color: var(--text);

  cursor: pointer;
}

.admin-save-btn,
.sched-save-btn {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-xs);

  font-weight: 600;

  letter-spacing: 0.07em;

  text-transform: uppercase;

  padding: 0.45em 0.9em;

  border-radius: var(--radius-sm);

  border: 0.07em solid var(--blue);

  background: var(--blue);

  color: #fff;

  cursor: pointer;
}

.admin-save-btn:hover,
.sched-save-btn:hover {

  background: var(--blue-lt);

  border-color: var(--blue-lt);
}

.admin-set-label {

  font-size: var(--fs-sm);

  color: var(--win-color);

  font-weight: 600;
}

.admin-locked {

  font-size: var(--fs-xs);

  color: var(--text-mute);

  font-style: italic;
}

.admin-clear-btn {

  font-family: 'Oswald', sans-serif;

  font-size: var(--fs-xs);

  font-weight: 600;

  letter-spacing: 0.07em;

  text-transform: uppercase;

  padding: 0.35em 0.7em;

  border-radius: var(--radius-sm);

  border: 0.07em solid var(--clear-border);

  background: transparent;

  color: var(--clear-color);

  cursor: pointer;
}

/* =========================================================
   TOAST
========================================================= */

.toast {

  position: fixed;

  bottom: 1.5em;
  left: 50%;

  transform:
    translateX(-50%)
    translateY(1.2em);

  background: var(--surface2);

  border: 0.07em solid var(--blue);

  border-radius: var(--radius-md);

  padding: 0.7em 1.2em;

  font-size: var(--fs-sm);

  color: var(--blue-lt);

  opacity: 0;

  transition: all 0.25s;

  pointer-events: none;

  z-index: 999;

  white-space: nowrap;
}

.toast.show {

  opacity: 1;

  transform:
    translateX(-50%)
    translateY(0);
}

.toast.error {

  border-color: var(--clear-color);

  color: var(--clear-color);
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  :root {

    --col-w: 12rem;
    --col-gap: 1rem;

  }

  .selector-row {
    flex-direction: column;
    align-items: stretch;
  }

  .round-game-header {
    flex-wrap: wrap;
  }

  .admin-game-row {
    align-items: flex-start;
  }

}

/* =========================================================
   PRINT
========================================================= */

@media print {

  .site-header,
  .view-tabs,
  .header-controls,
  .theme-toggle,
  .selector-row {
    display: none;
  }

  body {

    background: #fff;

    color: #000;
  }

  * {

    -webkit-print-color-adjust: exact;

    print-color-adjust: exact;
  }

}
