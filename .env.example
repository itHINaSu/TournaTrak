# ─── TournaTrak environment configuration (ALL OPTIONAL) ──────────────────────
# You do NOT need a .env file. On a fresh clone, `docker compose up -d --build`
# generates a random database password, session secret, and initial admin
# password on first boot (persisted in the tt-secrets volume). The admin
# credentials are printed once in `docker compose logs api`, and the plaintext
# stays recoverable via
#   docker compose exec api cat /run/tt-secrets/initial_admin_password
# until the first password change deletes it.
#
# Create a .env (copy from this file) only to OVERRIDE those defaults —
# explicit values here always win over generated ones. Values containing "$"
# must double it as "$$" (Compose interpolation).
#   5. Visit /admin — you will be prompted to change the default password.
#
# NOTE: Compose treats a single "$" in this file as a variable reference.
# Any literal "$" in a value (e.g. a bcrypt hash) must be doubled to "$$".
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Host user the API container runs as, so files written to the bind-mounted
# data dir (./files) are owned by you and not root. Defaults to 1000:1000 if
# unset. Find yours with `id -u` and `id -g`, then set them here if different.
PUID=1000
PGID=1000

# Set to true only if the browser connects over HTTPS all the way to this server.
# Leave false (default) when TLS is terminated upstream (HAProxy, Cloudflare, etc.)
# and the internal connection from nginx to Express is plain HTTP — otherwise the
# session cookie will have the Secure flag set but never be sent by the browser.
COOKIE_SECURE=false

# Long random string used to sign session cookies.
# REQUIRED — the server will not start without this.
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGEME_replace_with_at_least_32_random_chars

# Password for the bundled Postgres service (compose.yml passes it to both
# containers as discrete PG* env vars, so ANY characters are fine — no URL
# encoding involved). The database is not exposed outside the compose network,
# but use a real random value anyway. REQUIRED — compose will refuse to start
# without it. Remember Compose's "$" rule above if your value contains "$".
# NOTE: Postgres bakes this into its data volume on FIRST start; changing it
# later requires restoring the old value or wiping the volume
# (docker compose down -v — destroys all data).
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGEME_replace_with_a_random_db_password

# Admin login credentials.
# ADMIN_PASSWORD_HASH is the bcrypt hash of the current password.
# The default below is the hash of "TournaTrak" (with each "$" doubled to "$$"
# for Compose — see the note at the top of this file).
# You will be required to change it on first login (FORCE_PASSWORD_CHANGE=true).
# To pre-set a custom password instead of using the first-login prompt:
#   docker compose run --rm api node generate-hash.js yourpassword
#   Replace ADMIN_PASSWORD_HASH with the output (doubling each "$" to "$$"),
#   and set FORCE_PASSWORD_CHANGE=false.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$$2a$$12$$PlNaqDDGAJCZTN4yjqDLpu90aOIvNfV2JCp90F3yHcH4ifi3RxBZC
FORCE_PASSWORD_CHANGE=true
