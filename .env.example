# ─── TournaTrak environment configuration ─────────────────────────────────────
# Copy this file to .env and fill in real values before running docker compose.
# Or set these directly as `environment:` keys in compose.yml.
#
# Quick start:
#   1. Generate a session secret:  openssl rand -hex 32
#   2. Replace SESSION_SECRET below with the output.
#   3. Run: docker compose up -d --build
#   4. Visit /admin — you will be prompted to change the default password.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Set to true only if the browser connects over HTTPS all the way to this server.
# Leave false (default) when TLS is terminated upstream (HAProxy, Cloudflare, etc.)
# and the internal connection from nginx to Express is plain HTTP — otherwise the
# session cookie will have the Secure flag set but never be sent by the browser.
COOKIE_SECURE=false

# Long random string used to sign session cookies.
# REQUIRED — the server will not start without this.
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGEME_replace_with_at_least_32_random_chars

# Admin login credentials.
# ADMIN_PASSWORD_HASH is the bcrypt hash of the current password.
# The default below is the hash of "TournaTrak".
# You will be required to change it on first login (FORCE_PASSWORD_CHANGE=true).
# To pre-set a custom password instead of using the first-login prompt:
#   docker compose run --rm api node generate-hash.js yourpassword
#   Replace ADMIN_PASSWORD_HASH with the output, and set FORCE_PASSWORD_CHANGE=false.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$PlNaqDDGAJCZTN4yjqDLpu90aOIvNfV2JCp90F3yHcH4ifi3RxBZC
FORCE_PASSWORD_CHANGE=true
